# 관리자 계정 (최초 DB 시드)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# GitHub Personal Access Token (repo 권한 필요)
GITHUB_TOKEN=

# GitHub 저장소 (채널마다 같은 이름의 자산 레포)
# logos.opl.io.kr → openplatform-labs/logos
GITHUB_OWNER=openplatform-labs
GITHUB_BRANCH=main
# 필요 시 채널별 덮어쓰기
# GITHUB_REPO_LOGOS=logos
# GITHUB_REPO_IMAGES=images
# GITHUB_REPO_ILLUST=illust
# GITHUB_REPO_ICONS=icons
# GITHUB_REPO_PICTOGRAMS=pictograms
# GITHUB_REPO_AVATARS=avatars

# Statically CDN은 채널 레포에서 자동 생성됩니다.
# STATICALLY_CDN_BASE_LOGOS=https://cdn.statically.io/gh/openplatform-labs/logos@main

# 로컬 logos.json (선택, 레포 루트 기본)
# LOGOS_JSON_PATH=./logos.json

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password-no-spaces
SMTP_FROM=your@gmail.com

# 세션·OTP
SESSION_HOURS=1
OTP_EXPIRE_MINUTES=10

# 공개 사이트 URL (API·llms.txt 등)
SITE_BASE_URL=https://logos.opl.io.kr

# Okta OIDC (관리자 SSO, Authorization Code + PKCE)
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# OKTA_AUTHORIZE_URL=https://integrator-1653288.okta.com/oauth2/default/v1/authorize
# OKTA_TOKEN_URL=https://integrator-1653288.okta.com/oauth2/default/v1/token
# OKTA_USERINFO_URL=https://integrator-1653288.okta.com/oauth2/default/v1/userinfo
# OKTA_JWKS_URL=https://integrator-1653288.okta.com/oauth2/default/v1/keys
# OKTA_LOGOUT_URL=https://integrator-1653288.okta.com/oauth2/default/v1/logout
# OKTA_SCOPES=openid profile email
